import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15

import "./parameters"
import "../../io/qml"
import io.qml

Dialog {
    title: "OPTIMIZATION"
    modal: true
    width: 1000
    height: 700
    standardButtons: Dialog.Ok | Dialog.Cancel
    padding: 5


    Rectangle {
        anchors.fill: parent
        border.width: 1
        Row{
            anchors.fill: parent
            spacing : 5
            ScrollView{
                id: scrollView
                contentWidth: -1
                //height: parent.height *0.8
                //width: parent.width * 0.25
                Column{
                    id : productionColumn
                    padding: 10
                    spacing : 10
                    Repeater {
                        model: ["SCS",
                        "WMin",
                        "Horton",
                        "Holtan",
                        "Phi",
                        "Philip"]

                        delegate: GridParameters{
                            height: parent.height *0.25
                            width: parent.width
                            parameterModel : GridParametersQML{}
                            factoryName : "Production"
                            methodName : modelData
                        }
                    }


                }

            }


        }



    }
}
